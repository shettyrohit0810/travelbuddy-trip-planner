# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=trip_planner
POSTGRES_PORT=5432

# Security & JWT Tokens
SECRET_KEY=SUPER_SECRET_KEY_CHANGE_ME_IN_PRODUCTION
REFRESH_SECRET_KEY=SUPER_REFRESH_SECRET_KEY_CHANGE_ME_IN_PRODUCTION

# LLM Integrations
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Tool-grounding APIs (backend/app/tools/)
# Weather (Open-Meteo) needs no key.
# Amadeus for Developers: sign up free at https://developers.amadeus.com, self-service app -> test API key/secret
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here
AMADEUS_HOSTNAME=test.api.amadeus.com
# OpenTripMap: sign up free at https://opentripmap.io/product
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here
